startButton.MouseButton1Click:Connect(function()
    if running then
        return
    end

    local webhook = webhookBox.Text
    local interval = tonumber(intervalBox.Text)

    if not interval or interval <= 0 then
        interval = 1
    end

    if webhook ~= "" and not webhook:match(
        "^https://discord%.com/api/webhooks/"
    ) then
        status.Text = "Invalid webhook URL"
        return
    end

    running = true
    session = session + 1
    activeWebhook = webhook

    local currentSession = session

    startingMoney = parseMoney(getMoney())
    startTime = os.time()

    status.Text = "Status: Running"

    task.spawn(
        sendEmbed,
        activeWebhook,
        "Script started",
        65280
    )

    task.spawn(teleportLoop, currentSession)
    task.spawn(antiAFKLoop, currentSession)

    task.spawn(
        quidzCounterLoop,
        currentSession,
        activeWebhook,
        interval
    )

    task.spawn(
        reportLoop,
        currentSession,
        activeWebhook
    )
end)

