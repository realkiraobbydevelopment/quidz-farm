local function getMoney()
    local success, result = pcall(function()
        local moneyDisplay = player.PlayerGui
            :WaitForChild("GameUI")
            :WaitForChild("LeftHandButtons")
            :WaitForChild("MoneyDisplay")

        local label = moneyDisplay:FindFirstChildWhichIsA(
            "TextLabel",
            true
        )

        if not label then
            return "TextLabel not found"
        end

        print("[Quidz Farm] Money:", label.Text)

        return label.Text
    end)

    if success then
        return result
    end

    warn("[Quidz Farm] Error:", result)
    return "Unknown"
end

local function parseMoney(value)
    local cleaned = tostring(value)
        :gsub(",", "")
        :gsub("[^%d%.%-]", "")

    return tonumber(cleaned) or 0
end

local function formatDuration(seconds)
    seconds = math.max(0, math.floor(seconds))

    local days = math.floor(seconds / 86400)
    local hours = math.floor((seconds % 86400) / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local remainingSeconds = seconds % 60

    if days > 0 then
        return string.format(
            "%02d:%02d:%02d:%02d",
            days,
            hours,
            minutes,
            remainingSeconds
        )
    end

    return string.format(
        "%02d:%02d:%02d",
        hours,
        minutes,
        remainingSeconds
    )
end

local function getRequestFunction()
    return request or http_request or
        (syn and syn.request) or
        (fluxus and fluxus.request)
end

