local function sendEmbed(webhook, message, color)
    if webhook == "" then
        return false, "No webhook"
    end

    local requestFunction = getRequestFunction()

    if not requestFunction then
        return false, "HTTP unavailable"
    end

    local payload = {
        embeds = {
            {
                description = message,
                color = color,
                timestamp = DateTime.now():ToIsoDate()
            }
        }
    }

    local success, response = pcall(function()
        return requestFunction({
            Url = webhook,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(payload)
        })
    end)

    if not success then
        warn("[Quidz Farm] Webhook error:", response)
        return false, tostring(response)
    end

    local code = response.StatusCode or response.Status or 0

    if code == 200 or code == 204 then
        return true, "Sent"
    end

    warn("[Quidz Farm] Webhook HTTP error:", code)
    return false, "HTTP " .. tostring(code)
end

local function teleportLoop(mySession)
    while running and session == mySession do
        local character = player.Character
        local root = character and character:FindFirstChild(
            "HumanoidRootPart"
        )

        if root then
            root.CFrame = target
        end

        task.wait(3)
    end
end

local function antiAFKLoop(mySession)
    while running and session == mySession do
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)

        task.wait(60)
    end
end

local function quidzCounterLoop(mySession, webhook, interval)
    while running and session == mySession do
        local deadline = os.clock() + interval * 60

        while running and session == mySession
            and os.clock() < deadline do
            task.wait(math.min(1, deadline - os.clock()))
        end

        if not running or session ~= mySession then
            break
        end

        local money = getMoney()

        local message =
            "**quidz counter: " .. tostring(money) .. "**"
            .. "\n\nmade by kira obby development"

        if webhook ~= "" then
            local success, result = sendEmbed(
                webhook,
                message,
                65280
            )

            if success then
                status.Text = "Status: Quidz counter sent"
            else
                status.Text = "Status: " .. tostring(result)
            end
        end
    end
end

local function reportLoop(mySession, webhook)
    while running and session == mySession do
        local remaining = 3600 - (os.time() % 3600)
        local deadline = os.clock() + remaining

        while running and session == mySession
            and os.clock() < deadline do
            task.wait(math.min(1, deadline - os.clock()))
        end

        if not running or session ~= mySession then
            break
        end

        local money = getMoney()
        local currentMoney = parseMoney(money)

        local earned = currentMoney - startingMoney

        local elapsedSeconds = os.time() - startTime
        local elapsedHours = math.max(elapsedSeconds / 3600, 0.0001)

        local hourlyEarnings = earned / elapsedHours

        local currentTime = os.date("%H:%M")
        local runningTime = formatDuration(elapsedSeconds)

        local message =
            "**Hourly Report " .. currentTime .. "**"
            .. "\n\n**Starting Quidz: " .. tostring(startingMoney) .. "**"
            .. "\n**Current Quidz: " .. tostring(money) .. "**"
            .. "\n**Quidz Earned: " .. tostring(earned) .. "**"
            .. "\n**Hourly Quidz: " .. string.format("%.2f", hourlyEarnings) .. "**"
            .. "\n**Running Time: " .. runningTime .. "**"
            .. "\n\nmade by kira obby development"

        if webhook ~= "" then
            local success, result = sendEmbed(
                webhook,
                message,
                65280
            )

            if success then
                status.Text = "Status: Hourly report sent"
            else
                status.Text = "Status: " .. tostring(result)
            end
        end
    end
end

